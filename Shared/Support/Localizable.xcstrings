    "Error.DocumentDamaged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image could not be opened because part of it is missing or damaged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像は、一部が見つからないか破損しているため開けませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지의 일부가 없거나 손상되어 열 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开此图像，因为其中部分内容缺失或已损坏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法打開此影像，因為其中部分內容遺失或已損毀。"
          }
        }
      }
    },
    "Error.DocumentTooNew": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image was saved by a newer version of Easel. Update Easel to open it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像は新しいバージョンのEaselで保存されています。開くにはEaselをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지는 최신 버전의 Easel에서 저장되었습니다. 열려면 Easel을 업데이트하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图像由更新版本的 Easel 存储。请更新 Easel 以打开它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此影像由較新版本的 Easel 儲存。請更新 Easel 以打開它。"
          }
        }
      }
    },
    "Error.ImageUnreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picture could not be read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を読み込めませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 읽을 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取圖片。"
          }
        }
      }
    },
    "Error.ImageUnwritable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picture could not be saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 저장할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法存储图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存圖片。"
          }
        }
      }
    },
    "Error.ImportFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some pictures could not be added."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の画像を追加できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 사진을 추가할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分图片无法添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分圖片無法加入。"
          }
        }
      }
    },
    "Error.LayerHidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The layer is hidden. Show it to paint on it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーが非表示です。ペイントするには表示してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이어가 가려져 있습니다. 칠하려면 레이어를 표시하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图层已隐藏。请显示图层以在其上绘画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖層已隱藏。請顯示圖層以在上面繪圖。"
          }
        }
      }
    },
    "Error.LayerLocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The layer is locked. Unlock it in Layers to change it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーがロックされています。変更するには「レイヤー」でロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이어가 잠겨 있습니다. 변경하려면 레이어에서 잠금을 해제하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图层已锁定。请在“图层”中解锁以进行更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖層已鎖定。請在「圖層」中解鎖以進行更改。"
          }
        }
      }
    },
    "Error.MaskTool": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the brush, eraser and gradient can paint on a mask."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスクにペイントできるのは、ブラシ、消しゴム、グラデーションだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스크에는 브러시, 지우개, 그라디언트만 칠할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有画笔、橡皮擦和渐变可以在蒙版上绘画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有筆刷、橡皮擦和漸層可以在遮色片上繪圖。"
          }
        }
      }
    },
    "Error.NoLayer": {
      "extractionState": "manual",
      "localizations": {
