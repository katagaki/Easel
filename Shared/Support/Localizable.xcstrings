    "Error.PSDUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Photoshop document uses a colour mode or size Easel can't open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このPhotoshop書類は、Easelで開けないカラーモードまたはサイズを使用しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Photoshop 문서는 Easel에서 열 수 없는 색상 모드 또는 크기를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Photoshop 文稿使用了 Easel 无法打开的颜色模式或尺寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Photoshop 文件使用了 Easel 無法打開的色彩模式或尺寸。"
          }
        }
      }
    },
    "Error.PhotoUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo could not be opened. It may have been deleted or may still be downloading."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を開けませんでした。削除されたか、まだダウンロード中の可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 열 수 없습니다. 삭제되었거나 아직 다운로드 중일 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开照片。它可能已被删除或仍在下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法打開照片。它可能已被刪除或仍在下載。"
          }
        }
      }
    },
    "Error.PhotosAccessDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easel needs access to your photo library. You can allow it in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Easelには写真ライブラリへのアクセスが必要です。「設定」で許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Easel이 사진 보관함에 접근해야 합니다. 설정에서 허용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Easel 需要访问你的照片图库。你可以在“设置”中允许访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Easel 需要取用你的照片圖庫。你可以在「設定」中允許取用。"
          }
        }
