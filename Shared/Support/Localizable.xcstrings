      }
    },
    "LayerFilters.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filters run from top to bottom. Touch and hold a filter to drag it into a new place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルタは上から順に適用されます。フィルタを長押しすると、ドラッグして並べ替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터는 위에서 아래 순서로 적용됩니다. 필터를 길게 터치하여 드래그하면 순서를 변경할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滤镜从上到下依次应用。按住滤镜即可拖移以重新排序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "濾鏡由上至下依序套用。按住濾鏡即可拖移以重新排序。"
          }
        }
      }
    },
