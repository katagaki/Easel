    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easel saves the images you export to your library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Easelは書き出した画像をライブラリに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Easel은 내보낸 이미지를 보관함에 저장합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Easel 会将你导出的图像存储到图库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Easel 會將你輸出的影像儲存到圖庫。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easel opens photos from your library and saves your edits back to them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Easelはライブラリの写真を開き、編集内容をその写真に保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Easel은 보관함의 사진을 열고 편집 내용을 해당 사진에 다시 저장합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Easel 会打开图库中的照片，并将你的编辑存储回这些照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Easel 會打開圖庫中的照片，並將你的編輯儲存回這些照片。"
          }
        }
      }
    }
  },
  "version": "1.0"
}